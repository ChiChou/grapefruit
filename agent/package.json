{
  "name": "igf-agent",
  "version": "1.0.0",
  "description": "igf frida agent",
  "private": true,
  "main": "agent/index.ts",
  "type": "module",
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build:fruity": "frida-compile src/fruity/index.ts -o dist/fruity.js",
    "build:droid": "frida-compile src/droid/index.ts -o dist/droid.js",
    "build:transport": "frida-compile src/transport.ts -o dist/transport.js",
    "watch:fruity": "npm run build:fruity -- --watch",
    "watch:droid": "npm run build:droid -- --watch",
    "watch:transport": "npm run build:transport -- --watch",
    "build": "node scripts/build.ts",
    "postinstall": "patch-package",
    "prepare": "npm run build",
    "lint": "eslint src/**/*.ts",
    "type:emit": "tsgo -b tsconfig.types.json",
    "type:monaco": "node scripts/monaco.ts",
    "type": "npm run type:emit && npm run type:monaco"
  },
  "devDependencies": {
    "@types/frida-gum": "^19.0.2",
    "@types/node": "^24.12.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@typescript/native-preview": "7.0.0-dev.20251108.1",
    "eslint": "^9.39.4",
    "@types/tar-stream": "^3.1.4",
    "frida-compile": "^19.0.5",
    "patch-package": "^8.0.1",
    "tar-stream": "^3.1.7"
  },
  "dependencies": {
    "frida-il2cpp-bridge": "^0.13.0",
    "frida-java-bridge": "^7.0.12",
    "frida-objc-bridge": "^8.0.5",
    "frida-remote-stream": "^6.0.3",
    "frida-swift-bridge": "^3.0.2"
  }
}
